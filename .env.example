# ── OKX API Credentials ──────────────────────────────────────────────
OKX_API_KEY=your_api_key_here
OKX_SECRET_KEY=your_secret_key_here
OKX_PASSPHRASE=your_api_passphrase_here

# ── Mode ─────────────────────────────────────────────────────────────
# true = OKX Demo trading (paper, simulated money). Switch to false when ready to go live.
IS_DEMO=true

# ── Strategy Parameters (defaults match the spec — override only if needed) ──
LEVERAGE=45
RISK_PCT=0.01
RR_TARGET=2.5
BREAKEVEN_AT_R=1.0

# ── WhatsApp Alerts (via CallMeBot — free) ───────────────────────────
# Setup: go to https://callmebot.com/whatsapp.php
# Send "CallMeBot" via WhatsApp to the number shown on the site
# You'll receive an API key. Put your phone + key below.
# Phone format: international number without + (e.g. 27123456789)
WHATSAPP_PHONE=
WHATSAPP_API_KEY=

# ── Server ────────────────────────────────────────────────────────────
# HuggingFace requires port 7860
PORT=7860
